# Application
APP_NAME=PST Coach
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://pstcoach:changeme123@localhost:5432/pst_coach
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=pst-coach
S3_REGION=us-east-1

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=pst-coach

# Apache Tika
TIKA_SERVER_URL=http://localhost:9998

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
LLM_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Application Limits
MAX_PST_SIZE_MB=5000
MAX_EMAILS_PER_UPLOAD=500000
MAX_INDEXED_TIME_RANGE_MONTHS=24
MAX_CHAT_MESSAGES_PER_DAY=100
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Privacy
DEFAULT_REDACTION_LEVEL=strict
DEFAULT_RETENTION_DAYS=365
AUTO_DELETE_PST_AFTER_EXTRACTION=true

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Feature Flags
ENABLE_INSIGHTS=true
ENABLE_COACH_MODE=true
ENABLE_ATTACHMENT_EXTRACTION=false

# PST Coach Backend Configuration
# Rename this file to .env and fill in your values

# Application
APP_NAME=PST Coach
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://pstcoach:changeme123@127.0.0.1:5433/pst_coach

# Storage Directories (local paths)
DATA_DIR=data
UPLOAD_DIR=data/uploads
EXTRACTED_DIR=data/extracted

# Vector Database - Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENV=serverless
PINECONE_INDEX_NAME=pst-coach

# Apache Tika Server (for PST parsing)
TIKA_SERVER_URL=http://localhost:9998

# LLM - Anthropic Claude
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-3-5-sonnet-20241022

# Embeddings (local HuggingFace model)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Application Limits
MAX_PST_SIZE_MB=5000
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Privacy
DEFAULT_REDACTION_LEVEL=strict

# Logging
LOG_LEVEL=INFO

